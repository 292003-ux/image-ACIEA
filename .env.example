# ============================================================
# ACIEA website — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

# --- Core -----------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://aciea:CHANGE_ME@localhost:5432/aciea
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=
# Public URL of the site, without trailing slash (used for SEO, CORS/CSRF, emails)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local prototyping only: let Payload sync the schema without migrations.
# MUST be false (or unset) in production — use `pnpm migrate`.
PAYLOAD_DB_PUSH=false

# Secret used to salt hashed IP addresses for rate limiting (never stored raw)
IP_HASH_SALT=

# --- Storage --------------------------------------------------
# Directories for uploaded files (mount them as persistent volumes in Docker)
MEDIA_DIR=media
DOCUMENTS_DIR=media/documents
PRIVATE_UPLOADS_DIR=uploads/private

# --- Email (optional) -----------------------------------------
# Without SMTP, forms are stored in the admin but no notification is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ACIEA

# --- Anti-spam (optional) -------------------------------------
# Cloudflare Turnstile. Honeypot + timing + rate limiting are always active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Maps -----------------------------------------------------
# The project map uses self-hosted country outlines (Natural Earth) by default:
# no third-party request. To add a background tile layer, set both values below
# and list the tile hosts for the Content-Security-Policy, e.g.
#   NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_TILE_HOSTS=https://*.tile.openstreetmap.org
#   NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_URL=
MAP_TILE_HOSTS=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Jobs -----------------------------------------------------
# Set to true on serverless hosts; scheduled publishing then needs an external cron.
PAYLOAD_DISABLE_AUTORUN=false

# --- Seed (first install only) --------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
