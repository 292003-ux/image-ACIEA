{
  "name": "aciea-website",
  "version": "1.0.0",
  "private": true,
  "description": "Site institutionnel et CMS de l'ACIEA — Alliance for Climate Innovation and Ecological Action",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "tsx scripts/seed.ts",
    "media:prepare": "tsx scripts/prepare-media.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
