# Automatic HTTPS (Let's Encrypt) for the official ACIEA domain.
{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Long-lived caching for fingerprinted assets.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Uploaded files: 50 MB ceiling (application limits are stricter).
	request_body {
		max_size 50MB
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
